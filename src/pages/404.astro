---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="The page you requested does not exist.">
  <div class="wrap">
    <h1>Page not found</h1>
    <p class="lead">
      That page does not exist — it may have moved, or the link may be out of
      date.
    </p>
    <p>
      <a class="button button-secondary" href="/">Back to the home page</a>
    </p>
  </div>
</Base>
