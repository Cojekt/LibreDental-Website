---
import Base from "../layouts/Base.astro";
import OsIcon from "../components/OsIcon.astro";
import { releasesUrl, latestDownload } from "../site";

// Each row is [label, detail, x64 asset, ARM64 asset].
type Row = [string, string, string, string];

const platforms: {
  os: "windows" | "linux";
  name: string;
  note: string;
  desktop: Row[];
  server: Row[];
}[] = [
  {
    os: "windows",
    name: "Windows",
    note: "Windows 10 or 11",
    desktop: [
      [
        "Installer",
        "",
        "libredental-windows-amd64-installer.exe",
        "libredental-windows-arm64-installer.exe",
      ],
    ],
    server: [
      [
        "Server",
        ".exe",
        "libredental-server-windows-amd64.exe",
        "libredental-server-windows-arm64.exe",
      ],
    ],
  },
  {
    os: "linux",
    name: "Linux",
    note: "Most distributions",
    desktop: [
      [
        "AppImage",
        "Any distribution",
        "libredental-linux-amd64.AppImage",
        "libredental-linux-arm64.AppImage",
      ],
      [
        ".deb",
        "Debian, Ubuntu",
        "libredental-linux-amd64.deb",
        "libredental-linux-arm64.deb",
      ],
      [
        ".rpm",
        "Fedora, openSUSE",
        "libredental-linux-amd64.rpm",
        "libredental-linux-arm64.rpm",
      ],
      [
        ".pkg.tar.zst",
        "Arch",
        "libredental-linux-amd64.pkg.tar.zst",
        "libredental-linux-arm64.pkg.tar.zst",
      ],
    ],
    server: [
      [
        "Server",
        "Binary",
        "libredental-server-linux-amd64",
        "libredental-server-linux-arm64",
      ],
    ],
  },
];

const sections = [
  {
    key: "desktop" as const,
    title: "Desktop app",
    note: "For a single computer.",
  },
  {
    key: "server" as const,
    title: "Office server",
    note: "Runs on one PC; other workstations connect from a browser.",
  },
];
---

<Base
  title="Download"
  description="Download LibreDental for Windows and Linux, as a desktop app or as an office server for multi-workstation practices."
>
  <div class="wrap">
    <h1>Download LibreDental</h1>
    <div class="notice" role="note">
      <p class="notice-title">Alpha software: do not use with real patient data</p>
      <p>
        LibreDental is still in early development. Features change between
        releases and data loss is possible. Use it to try things out, with the
        demo data below or made-up records, but keep running your practice on
        your current system for now.
      </p>
    </div>

    <p class="lead">
      These links always point at the latest alpha release. Check the
      <a href={releasesUrl}>release notes</a> for what changed.
    </p>

    <div class="platform-grid">
      {
        platforms.map((p) => (
          <section class="platform" aria-labelledby={`dl-${p.os}`}>
            <header class="platform-head">
              <OsIcon os={p.os} />
              <div>
                <h2 id={`dl-${p.os}`}>{p.name}</h2>
                <p class="platform-note">{p.note}</p>
              </div>
            </header>

            {sections.map((s) => (
              <div class="platform-section">
                <h3>{s.title}</h3>
                <p class="platform-section-note">{s.note}</p>
                <ul class="dl-rows">
                  {p[s.key].map(([label, detail, x64, arm64]) => (
                    <li class="dl-row">
                      <span class="dl-label">
                        {label}
                        {detail && <span class="dl-detail">{detail}</span>}
                      </span>
                      <span class="dl-arches">
                        <a
                          class="dl-pill"
                          href={latestDownload(x64)}
                          aria-label={`${p.name} ${s.title} ${label}, x64`}
                        >
                          x64
                        </a>
                        <a
                          class="dl-pill"
                          href={latestDownload(arm64)}
                          aria-label={`${p.name} ${s.title} ${label}, ARM64`}
                        >
                          ARM64
                        </a>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))
      }
    </div>

    <h2>Which one do I need?</h2>
    <ul>
      <li>
        <strong>Desktop app or office server?</strong> Use the desktop app if
        LibreDental will run on one computer. If several workstations need to
        share the same data, install the office server on one PC and open
        LibreDental from a web browser on the others.
      </li>
      <li>
        <strong>x64 or ARM64?</strong> Most desktops and laptops are x64.
        Choose ARM64 for ARM-based machines, such as Windows laptops with
        Snapdragon processors or a Raspberry Pi.
      </li>
    </ul>

    <h2>macOS</h2>
    <p>macOS builds aren't available yet.</p>

    <h2>Try it with sample data</h2>
    <p>
      Each release includes a fictional demo practice you can load to explore
      the app: a <a href={latestDownload("libredental-demo-us-small.zip")}
        >small one</a
      > (about 18 patients) and a <a
        href={latestDownload("libredental-demo-us-large.zip")}>large one</a
      > (about 500 patients). The <a href="/docs/getting-started/#demo-data"
        >installation guide</a
      > explains how to load them.
    </p>

    <h2>Verify your download</h2>
    <p>
      Compare your file against <a href={latestDownload("checksums.txt")}
        >checksums.txt</a
      >. Older versions are on the <a href={releasesUrl}>releases page</a>.
    </p>
  </div>
</Base>
