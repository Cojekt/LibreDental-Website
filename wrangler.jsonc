{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "libredental-site",
  // Set this to today's date
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Attach the site to the domain. Cloudflare creates the DNS records and
  // HTTPS certificates for these automatically on deploy.
  "routes": [
    { "pattern": "libredental.com", "custom_domain": true },
    { "pattern": "www.libredental.com", "custom_domain": true }
  ]
}
